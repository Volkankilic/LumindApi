{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "lumind-api",
    "Audience": "lumind-client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshTokenMaxDays": 30,
    "CookieSecure": true,
    "CodeAttempts": 5,
    "CodeWindowSeconds": 30,
    "RefreshAttempts": 30,
    "RefreshWindowSeconds": 60
  },
  "Documents": {
    "PrivacyNoticeVersion": "0.1-taslak",
    "ConsentVersion": "0.1-taslak"
  },
  "Privacy": {
    "DeleteContentOnWithdrawal": true
  },
  "Chat": {
    "ContextMessages": 20,
    "MaxMessageLength": 2000,
    "MessagesPerMinute": 20,
    "Fake": {
      "FirstTokenDelayMs": 1000,
      "TokenDelayMs": 60
    }
  },
  "Database": {
    "ExpectedSchemaVersion": 2
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
