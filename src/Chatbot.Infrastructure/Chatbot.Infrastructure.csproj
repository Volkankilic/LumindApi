<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Chatbot.Application\Chatbot.Application.csproj" />
    <ProjectReference Include="..\Chatbot.Domain\Chatbot.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The crisis phrase list ships inside the assembly: no file to lose in a deployment, no I/O at runtime. -->
    <!-- WithCulture=false: MSBuild would read ".tr." in the name as the Turkish culture and move the file into a satellite assembly. -->
    <EmbeddedResource Include="Chat\Crisis\crisis-phrases.tr.json" WithCulture="false" LogicalName="Chatbot.Infrastructure.Chat.Crisis.crisis-phrases.tr.json" />
    <!-- The system prompt of the model ships inside the assembly too (same reasoning; the version stored with each reply is a hash of its text). -->
    <EmbeddedResource Include="Chat\Llm\system-prompt.tr.txt" WithCulture="false" LogicalName="Chatbot.Infrastructure.Chat.Llm.system-prompt.tr.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared framework only (IHostEnvironment, configuration): no extra package. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Design time only: `dotnet ef dbcontext script` drafts api/db/001_initial.sql. Never used to change a database. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
